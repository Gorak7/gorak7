index=* (sourcetype=*zeek* OR sourcetype=*suricata* OR sourcetype=*firewall* OR sourcetype=*netflow*)
| eval source=coalesce(src_ip, src, id_orig_h, SourceAddress)
| eval destination_port=coalesce(dest_port, dst_port, id_resp_p, DestinationPort)
| where isnotnull(source) AND isnotnull(destination_port)
| stats dc(destination_port) as unique_ports count as connections values(destination_port) as ports by source
| where unique_ports >= 15
| sort - unique_ports
