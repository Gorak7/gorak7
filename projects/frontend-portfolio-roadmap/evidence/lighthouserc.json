{
  "ci": {
    "collect": {
      "url": ["http://127.0.0.1:4173", "http://127.0.0.1:5173"],
      "startServerCommand": "(cd ../your-ui && npm run dev -- --host 127.0.0.1 --port 4173) & (cd ../syncboard/server && npm run dev) & (cd ../syncboard/client && npm run dev -- --host 127.0.0.1 --port 5173) & wait",
      "startServerReadyPattern": "4173",
      "numberOfRuns": 3,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.75 }],
        "categories:accessibility": ["warn", { "minScore": 0.85 }],
        "categories:best-practices": ["warn", { "minScore": 0.85 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "./lighthouse-reports" }
  }
}