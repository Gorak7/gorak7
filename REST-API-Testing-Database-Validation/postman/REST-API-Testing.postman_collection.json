{
  "info": {
    "name": "REST API Testing and Database Validation",
    "description": "Local CRUD, authorization, and validation scenarios. Run in order; Create saves userId for subsequent requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "apiKey",
      "value": "qa-demo-key"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "createdEmail",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "GET all users - positive",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.test('Response is JSON', () => pm.response.to.be.json);",
              "pm.test('Response time under 1500ms local baseline', () => pm.expect(pm.response.responseTime).to.be.below(1500));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET all users - missing API key",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Missing key returns 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "POST create user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"QA Demo User\",\"email\":\"qa.demo.{{$timestamp}}@example.com\",\"role\":\"QA Tester\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create returns 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Response has ID and fields', () => { pm.expect(body.id).to.be.a('number'); pm.expect(body.name).to.eql('QA Demo User'); pm.expect(body.email).to.include('@example.com'); });",
              "pm.collectionVariables.set('userId', body.id);",
              "pm.collectionVariables.set('createdEmail', body.email);"
            ]
          }
        }
      ]
    },
    {
      "name": "GET created user",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/users/{{userId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('GET by ID returns 200', () => pm.response.to.have.status(200));",
              "pm.test('ID matches created ID', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('userId'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "POST invalid email - negative",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Invalid Email\",\"email\":\"not-an-email\",\"role\":\"QA Tester\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invalid email returns 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "PATCH update name",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"QA Demo Updated\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/users/{{userId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('PATCH returns 200', () => pm.response.to.have.status(200));",
              "pm.test('Name changed', () => pm.expect(pm.response.json().name).to.eql('QA Demo Updated'));"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT replace user",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"QA Demo Replaced\",\"email\":\"{{createdEmail}}\",\"role\":\"Analyst\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/users/{{userId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('PUT returns 200', () => pm.response.to.have.status(200));",
              "pm.test('Role updated', () => pm.expect(pm.response.json().role).to.eql('Analyst'));"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE created user",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/users/{{userId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('DELETE returns 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET deleted user - verify deletion",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/users/{{userId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Deleted record returns 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}